# ThreatIQ v4.0 Environment Configuration
# Copy to .env and fill in real values

# ── App ────────────────────────────────────────
APP_NAME=ThreatIQ
APP_VERSION=4.0.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# ── PostgreSQL ──────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=threatiq
POSTGRES_PASSWORD=threatiq_dev_password
POSTGRES_DB=threatiq

# ── Redis ───────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── MISP (real CTI feed) ────────────────────────
# Leave blank to use offline sample data
MISP_URL=
MISP_API_KEY=
MISP_VERIFY_SSL=true

# ── CIRCL (no auth needed for public endpoints)─
CIRCL_USERNAME=
CIRCL_PASSWORD=

# ── OTX / AlienVault (replaces FS-ISAC) ─────────
# Free, no membership approval -- register at https://otx.alienvault.com
# and copy your API key from https://otx.alienvault.com/api
# Leave blank to use offline sample data.
OTX_API_KEY=
OTX_API_URL=https://otx.alienvault.com/api/v1

# ── Wazuh SIEM (pull connector) ─────────────────
# Free, open-source. Points at the Wazuh indexer's OpenSearch-compatible
# API (default port 9200), not the manager's REST API.
# Leave blank to use offline sample alerts.
WAZUH_INDEXER_URL=
WAZUH_API_USERNAME=
WAZUH_API_PASSWORD=
WAZUH_VERIFY_SSL=true

# ── MISP export (push -- reuses MISP_URL / MISP_API_KEY above) ─
# Publishes ThreatIQ's own high-confidence classified IoCs to the same
# MISP instance MISPConnector pulls from. Wazuh's own MISP integration
# module (configured on the Wazuh side) then polls MISP and auto-generates
# detection rules from ThreatIQ's output. No separate credentials needed.

# ── OpenCTI Enrichment Connector ───────────────
OPENCTI_URL=
OPENCTI_TOKEN=
OPENCTI_CONNECTOR_ID=threatiq-enrichment-connector
OPENCTI_CONNECTOR_CONFIDENCE_LEVEL=75

# ── Model paths ─────────────────────────────────
MODEL_DIR=./model_artifacts
MITRE_ATTACK_DATA_PATH=./data/mitre_attack/enterprise-attack.json
